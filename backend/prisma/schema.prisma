// =============================================================================
// SERVITEX — Schema de Base de Datos (Prisma ORM)
// Versión: 1.0.0
// Entregable: Módulo de Órdenes de Compra (Sección 1)
// Tipado Estricto: Todos los valores monetarios y físicos son Float.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMERACIONES
// =============================================================================

/// Tipos de cliente reconocidos por el sistema comercial de SERVITEX.
enum TipoCliente {
  EMPRESA
  PERSONA_NATURAL
  TALLER_EXTERNO
  DISTRIBUIDOR
}

/// Composición de fibra del artículo. Determina la ruta química en el formulario técnico.
enum ComposicionFibra {
  ALGODON
  NYLON
  POLIESTER
  MULTIFIBRA_ALGODON_NYLON
  MULTIFIBRA_ALGODON_POLIESTER
  MULTIFIBRA_NYLON_POLIESTER
}

/// Estado del ciclo de vida de una Orden de Compra.
enum EstadoOrden {
  PENDIENTE    // Registrada, sin iniciar producción
  EN_PROCESO   // Al menos un lote está en formulario técnico
  COMPLETADA   // Todos los lotes han sido procesados
  ANULADA      // Cancelada por el cliente o el taller
}

// =============================================================================
// MODELO: Cliente
// Catálogo maestro de clientes. Reutilizable en múltiples órdenes de compra.
// =============================================================================
model Cliente {
  id            Int           @id @default(autoincrement())
  nombre        String        @db.VarChar(200)
  tipoCliente   TipoCliente
  ruc           String?       @unique @db.VarChar(11)   // RUC opcional para empresas
  telefono      String?       @db.VarChar(15)
  correo        String?       @db.VarChar(150)
  direccion     String?       @db.VarChar(300)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  /// Relación: un cliente puede tener muchas órdenes de compra.
  ordenes       OrdenCompra[]

  /// Índice único compuesto para el patrón upsert del servicio.
  /// Permite buscar/crear clientes por nombre + tipo sin duplicados.
  @@unique([nombre, tipoCliente], name: "nombre_tipoCliente")
  @@map("clientes")
}

// =============================================================================
// MODELO: OrdenCompra (CABECERA)
// Datos fijos que el usuario registra una sola vez al inicio.
// Regla: Una OrdenCompra tiene MUCHOS DetalleOrden (teñidos individuales).
// =============================================================================
model OrdenCompra {
  id               Int           @id @default(autoincrement())

  /// Número de Orden de Compra: código único del documento físico/PDF del cliente.
  /// Este es el identificador de negocio visible en pantalla (ej. "OC-2026-0045").
  numeroOC         String        @unique @db.VarChar(50)

  /// FK al catálogo de clientes.
  clienteId        Int
  cliente          Cliente       @relation(fields: [clienteId], references: [id])

  /// Estado operativo de la orden en el flujo de producción.
  estado           EstadoOrden   @default(PENDIENTE)

  /// Observaciones generales de la OC (no confundir con obs. técnicas de cada lote).
  observaciones    String?       @db.Text

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  /// Relación 1-N: cada fila de detalle es un teñido individual independiente.
  /// Regla de indexación operativa: permite cuantificar procesos reales en planta.
  detalles         DetalleOrden[]

  @@map("ordenes_compra")
}

// =============================================================================
// MODELO: DetalleOrden (FILAS DINÁMICAS — Teñido Individual)
// Cada fila representa un lote de teñido independiente asociado a una OC.
// Regla estricta: Cantidad, Precio por Metro y Total son OBLIGATORIAMENTE Float.
// Regla de Unidad de Medida: SIEMPRE "Metros" — fijado como constante de negocio.
// =============================================================================
model DetalleOrden {
  id                 Int          @id @default(autoincrement())

  /// FK a la cabecera de la Orden de Compra.
  ordenCompraId      Int
  ordenCompra        OrdenCompra  @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)

  /// CANTIDAD de metros del lote. Tipo Float obligatorio (permite decimales como 1.5 m).
  cantidad           Float

  /// UNIDAD DE MEDIDA — VALOR FIJO DE NEGOCIO: siempre "Metros".
  /// No se expone como campo editable en la UI. Se almacena para integridad del registro.
  unidadMedida       String       @default("Metros") @db.VarChar(20)

  /// Descripción del artículo textil (ej. "Avío", "Prenda", "Cierre", "Tela cruda").
  descripcionArticulo String      @db.VarChar(300)

  /// Color solicitado por el cliente (ej. "Keeneland Khaki", "Navy Blue").
  colorSolicitado    String       @db.VarChar(150)

  /// PRECIO POR METRO en soles (S/.). Tipo Float obligatorio.
  precioPorMetro     Float

  /// TOTAL DE FILA calculado automáticamente: cantidad * precioPorMetro.
  /// Se calcula en backend antes de insertar; nunca se confía solo en el frontend.
  total              Float

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  /// Relación inversa: cada detalle puede tener una RecetaTecnica de laboratorio.
  recetaTecnica      RecetaTecnica?

  @@map("detalles_orden")
}

// =============================================================================
// MODELO: RecetaTecnica (FORMULARIO TÉCNICO — Módulo Sección 2)
// Control de consumo y recetas de laboratorio por lote de teñido.
// Vinculada 1-a-1 con un DetalleOrden específico.
// Este modelo se expandirá en el Entregable 2 con la lógica química completa.
// =============================================================================
model RecetaTecnica {
  id                  Int              @id @default(autoincrement())

  /// Relación 1-1 con el lote de teñido (DetalleOrden).
  detalleOrdenId      Int              @unique
  detalleOrden        DetalleOrden     @relation(fields: [detalleOrdenId], references: [id], onDelete: Cascade)

  // ------------------------------------------------------------------
  // DATOS FÍSICOS DE ENTRADA (Sección 2.1 del documento)
  // ------------------------------------------------------------------

  /// Peso real del artículo medido en balanza de planta. Tipo Float obligatorio.
  pesoRealKg          Float

  /// Composición de fibra del artículo. Define la ruta química automática.
  composicionFibra    ComposicionFibra

  /// Relación de Baño (ej. 1:40). Se almacena la parte numérica (40.0).
  /// El sistema calculará automáticamente los litros de agua: pesoRealKg * relacionBano.
  relacionBano        Float

  /// Litros de agua del baño principal, calculado por el sistema.
  /// Formula: pesoRealKg * relacionBano
  litrosAgua          Float

  // ------------------------------------------------------------------
  // FÓRMULA DEL COLOR (definida por filtro de fibra en UI — Sección 2.2)
  // Los colorantes y porcentajes se almacenan como JSON flexible.
  // Estructura esperada: [{ "colorante": "Dianix Blue", "porcentaje": 0.5 }]
  // ------------------------------------------------------------------

  /// Lista de colorantes compatibles y sus porcentajes de concentración.
  formulaColorJson    Json             @default("[]")

  /// Nivel de intensidad calculado (1=Pasteles, 2=Claros, 3=Intermedios, 4=Intensos).
  /// Se determina por la suma total de porcentajes de la Fórmula del Color.
  nivelIntensidad     Int?

  // ------------------------------------------------------------------
  // OBSERVACIONES TÉCNICAS (Sección 2.3)
  // ------------------------------------------------------------------

  /// Notas específicas del dueño: incidencias, excepciones del cliente.
  /// Ejemplo: "cliente solicita omitir suavizado".
  observacionesTecnicas String?       @db.Text

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("recetas_tecnicas")
}
